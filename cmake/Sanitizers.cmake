include_guard(GLOBAL)

set(USE_SANITIZER "" CACHE STRING
    "Semicolon-separated list of sanitizers: Address, Undefined, Thread, Leak, Memory, MemoryWithOrigins")

function(my_project_enable_sanitizers target_name)
    if(NOT USE_SANITIZER)
        return()
    endif()

    if(NOT (CMAKE_CXX_COMPILER_ID STREQUAL "GNU" OR CMAKE_CXX_COMPILER_ID MATCHES "Clang"))
        message(WARNING "Sanitizers are only configured for GCC and Clang.")
        return()
    endif()

    set(SANITIZER_LIST "")
    set(HAS_ADDRESS OFF)
    set(HAS_THREAD OFF)
    set(HAS_MEMORY OFF)
    set(HAS_LEAK OFF)

    foreach(item IN LISTS USE_SANITIZER)
        string(TOLOWER "${item}" item_lower)
        if(item_lower STREQUAL "address")
            list(APPEND SANITIZER_LIST "address")
            set(HAS_ADDRESS ON)
        elseif(item_lower STREQUAL "undefined")
            list(APPEND SANITIZER_LIST "undefined")
        elseif(item_lower STREQUAL "thread")
            list(APPEND SANITIZER_LIST "thread")
            set(HAS_THREAD ON)
        elseif(item_lower STREQUAL "leak")
            list(APPEND SANITIZER_LIST "leak")
            set(HAS_LEAK ON)
        elseif(item_lower STREQUAL "memory")
            list(APPEND SANITIZER_LIST "memory")
            set(HAS_MEMORY ON)
        elseif(item_lower STREQUAL "memorywithorigins")
            list(APPEND SANITIZER_LIST "memory")
            set(HAS_MEMORY ON)
            set(MEMORY_WITH_ORIGINS ON)
        else()
            message(FATAL_ERROR
                "Unsupported sanitizer '${item}'. Supported values: Address, Undefined, Thread, Leak, Memory, MemoryWithOrigins.")
        endif()
    endforeach()

    # Validate mutually exclusive combinations
    if(HAS_ADDRESS AND HAS_THREAD)
        message(FATAL_ERROR "Invalid USE_SANITIZER='${USE_SANITIZER}': Address and Thread sanitizers cannot be combined.")
    endif()
    if(HAS_ADDRESS AND HAS_MEMORY)
        message(FATAL_ERROR "Invalid USE_SANITIZER='${USE_SANITIZER}': Address and Memory sanitizers cannot be combined.")
    endif()
    if(HAS_THREAD AND HAS_MEMORY)
        message(FATAL_ERROR "Invalid USE_SANITIZER='${USE_SANITIZER}': Thread and Memory sanitizers cannot be combined.")
    endif()
    if(HAS_LEAK AND HAS_THREAD)
        message(FATAL_ERROR "Invalid USE_SANITIZER='${USE_SANITIZER}': Leak and Thread sanitizers cannot be combined.")
    endif()
    if(HAS_LEAK AND HAS_MEMORY)
        message(FATAL_ERROR "Invalid USE_SANITIZER='${USE_SANITIZER}': Leak and Memory sanitizers cannot be combined.")
    endif()
    if(HAS_MEMORY AND NOT CMAKE_CXX_COMPILER_ID MATCHES "Clang")
        message(FATAL_ERROR "MemorySanitizer requires Clang (current compiler: ${CMAKE_CXX_COMPILER_ID}).")
    endif()

    list(REMOVE_DUPLICATES SANITIZER_LIST)
    string(REPLACE ";" "," SANITIZER_FLAGS "${SANITIZER_LIST}")

    set(EXTRA_FLAGS "-fsanitize=${SANITIZER_FLAGS}" "-fno-omit-frame-pointer")
    if(MEMORY_WITH_ORIGINS)
        list(APPEND EXTRA_FLAGS "-fsanitize-memory-track-origins")
    endif()

    message(STATUS "[my_project] Enabling sanitizers on '${target_name}': ${SANITIZER_FLAGS}")
    target_compile_options(${target_name} PUBLIC $<BUILD_INTERFACE:${EXTRA_FLAGS}>)
    target_link_options(${target_name} PUBLIC $<BUILD_INTERFACE:${EXTRA_FLAGS}>)
endfunction()
